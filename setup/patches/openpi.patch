 @dataclasses.dataclass(frozen=True)
+class LeRobotManiSkillDataConfig(DataConfigFactory):
+    """Read the local 25 x 50 ManiSkill LeRobot dataset for both training and inference."""
+
+    @override
+    def create(self, assets_dirs: pathlib.Path, model_config: _model.BaseModelConfig) -> DataConfig:
+        repack = _transforms.Group(inputs=[_transforms.RepackTransform({
+            "observation/image": "image",
+            "observation/wrist_image": "wrist_image",
+            "observation/target_image": "target_image",
+            "observation/state": "state",
+            "actions": "actions",
+            "prompt": "prompt",
+        })])
+        joint_mask = _transforms.make_bool_mask(7, -1)
+        data_transforms = _transforms.Group(
+            inputs=[maniskill_policy.ManiSkillInputs(), _transforms.DeltaActions(joint_mask)],
+            outputs=[_transforms.AbsoluteActions(joint_mask), maniskill_policy.ManiSkillOutputs()],
+        )
+        return dataclasses.replace(
+            self.create_base_config(assets_dirs, model_config),
+            repack_transforms=repack,
+            data_transforms=data_transforms,
+            model_transforms=ModelTransformFactory()(model_config),
+        )
+
+
+@dataclasses.dataclass(frozen=True)
+class RoboCasaDataConfig(DataConfigFactory):
+    """23D robot state / 7D world OSC delta, with three same-frame RGB streams.
+
+    The pilot raw-H5 loader supplies the observation/* keys directly. This
+    config is also usable by the standard policy builder at inference.
+    """
+    repo_id: str = "robocasa/pilot_v1"
+    assets: AssetsConfig = dataclasses.field(default_factory=lambda: AssetsConfig(asset_id="robocasa_pilot_v1"))
+
+    @override
+    def create(self, assets_dirs: pathlib.Path, model_config: _model.BaseModelConfig) -> DataConfig:
+        if not isinstance(model_config, pi0_config.Pi0Config) or not model_config.pi05 or not model_config.discrete_state_input:
+            raise ValueError("RoboCasa pi05 must tokenize the real 23D state")
+        model_transforms = ModelTransformFactory(default_prompt=robocasa_policy.PROMPT)(model_config)
+        return dataclasses.replace(
+            self.create_base_config(assets_dirs, model_config),
+            data_transforms=_transforms.Group(inputs=[robocasa_policy.RoboCasaInputs()],
+                                             outputs=[robocasa_policy.RoboCasaOutputs()]),
+            model_transforms=_transforms.Group(inputs=[robocasa_policy.ClipNormalizedState(), *model_transforms.inputs],
+                                              outputs=model_transforms.outputs),
+            use_quantile_norm=True,
+        )
+
+
